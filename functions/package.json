{
  "name": "functions",
  "description": "Cloud Functions for the SACG garden app",
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "gcp-build": "tsc",
    "test": "firebase emulators:exec --only firestore --project demo-sacg \"vitest run\"",
    "test:unit": "vitest run",
    "serve": "npm run build && firebase emulators:start --only functions",
    "deploy": "firebase deploy --only functions"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@google-cloud/secret-manager": "^7.2.0",
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^6.1.0",
    "luxon": "^3.7.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.6",
    "typescript": "^5.6.2",
    "vitest": "^4.1.12"
  }
}
