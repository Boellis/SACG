rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function exists_(uid) { return exists(/databases/$(database)/documents/members/$(uid)); }
    function memberData() { return get(/databases/$(database)/documents/members/$(request.auth.uid)).data; }
    function isAdmin() { return signedIn() && exists_(request.auth.uid) && memberData().role == 'admin'; }
    function isActive() { return signedIn() && exists_(request.auth.uid) && memberData().status == 'active'; }
    // A member's own RSVP: known keys only, a real answer, a sane party size and note.
    function validRsvp(d) {
      return d.keys().hasOnly(['status', 'displayName', 'respondedAt', 'partySize', 'note', 'source'])
        && d.status in ['yes', 'no', 'maybe']
        && (!('partySize' in d) || (d.partySize is int && d.partySize >= 1 && d.partySize <= 20))
        && (!('note' in d) || (d.note is string && d.note.size() <= 500));
    }

    match /settings/{doc} {
      allow read: if isActive() || isAdmin();
      allow write: if isAdmin();
    }

    match /members/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.role == 'member'
        && request.resource.data.status == 'pending';
      allow update: if isAdmin() || (signedIn() && request.auth.uid == uid
        && request.resource.data.role == resource.data.role
        && request.resource.data.status == resource.data.status
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName','phone']));
      allow delete: if isAdmin();
    }

    match /plots/{id} {
      allow read: if isActive() || isAdmin();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (isActive()
        && (resource.data.holderMemberId == request.auth.uid
            || (('holderMemberIds' in resource.data) && (request.auth.uid in resource.data.holderMemberIds)))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['crops', 'layout', 'layout3d', 'lastWateredAt']));
    }

    match /events/{id} {
      allow read: if isActive() || isAdmin();
      allow write: if isAdmin();
      match /rsvps/{uid} {
        allow read: if isActive() || isAdmin();
        allow create, update: if isAdmin()
          || (signedIn() && request.auth.uid == uid && validRsvp(request.resource.data));
        allow delete: if isAdmin() || (signedIn() && request.auth.uid == uid);
      }
    }

    // Server-only: RSVP link tokens and the assistant's daily usage counters.
    match /rsvpInvites/{token} {
      allow read, write: if false;
    }
    match /assistantUsage/{doc} {
      allow read, write: if false;
    }

    // Member email jobs: admins watch progress; only Cloud Functions write.
    match /emailJobs/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // AI assistant threads and everything beneath them: admin read, server write.
    match /assistantThreads/{id} {
      allow read: if isAdmin();
      allow write: if false;
      match /{sub=**} {
        allow read: if isAdmin();
        allow write: if false;
      }
    }

    match /volunteerHours/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.memberId == request.auth.uid);
      allow create: if isAdmin() || (isActive() && request.resource.data.memberId == request.auth.uid);
      allow update, delete: if isAdmin() || (isActive() && resource.data.memberId == request.auth.uid);
    }

    match /mail/{id} {
      allow read, delete: if isAdmin();
      allow create: if isAdmin();
    }

    match /threads/{id} {
      allow read: if isActive() || isAdmin();
      allow create: if isActive() && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if isAdmin() || (isActive() && resource.data.authorId == request.auth.uid);
      match /replies/{rid} {
        allow read: if isActive() || isAdmin();
        allow create: if isActive() && request.resource.data.authorId == request.auth.uid;
        allow update, delete: if isAdmin() || (isActive() && resource.data.authorId == request.auth.uid);
      }
    }

    // Members Lounge directory — public-safe member info (name + join date).
    match /directory/{id} {
      allow read: if isActive() || isAdmin();
      allow write: if isAdmin();
    }

    // Lounge billboard announcements — any active member reads; admins write.
    match /announcements/{id} {
      allow read: if isActive() || isAdmin();
      allow write: if isAdmin();
    }

    // 1:1 direct messages — only the two participants can see or write a conversation.
    match /conversations/{cid} {
      allow read, update: if signedIn() && request.auth.uid in resource.data.participants;
      allow create: if isActive()
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants.size() == 2;

      match /messages/{mid} {
        allow read: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(cid)).data.participants;
        allow create: if isActive()
          && request.resource.data.senderId == request.auth.uid
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(cid)).data.participants;
      }
    }

    // Shared documents metadata — any active member reads; admins write.
    match /documents/{id} {
      allow read: if isActive() || isAdmin();
      allow write: if isAdmin();
    }

    // Polls / surveys — admins author polls; active members cast one vote each
    // (vote doc id = voter uid → one vote per member).
    match /polls/{id} {
      allow read: if isActive() || isAdmin();
      allow write: if isAdmin();
      match /votes/{uid} {
        allow read: if isActive() || isAdmin();
        allow create, update: if isActive()
          && request.auth.uid == uid
          && request.resource.data.memberId == request.auth.uid;
      }
    }
  }
}
