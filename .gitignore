# Dependencies
node_modules/
*/node_modules/

# Build output
dist/
build/

# Environment / secrets
.env
.env.local
.env.*.local

# member-cleanup: never commit credentials or generated reports
member-cleanup/serviceAccount.json
member-cleanup/report-*.json

# This repo is PUBLIC: never commit member data or credentials. In CI,
# scripts/security/scan-repo.mjs rejects most of these by name as well
# (FORBIDDEN_PATHS in scripts/security/patterns.mjs), plus any member email or
# phone number in tracked files; gitleaks only looks for secrets.
members_list*.txt
*.roster.*
# Roster exports (the scanner tests may keep csv fixtures)
*.csv
!scripts/security/fixtures/**/*.csv
*.xlsx
backup-*.json
report-*.json
**/serviceAccount*.json
*-firebase-adminsdk-*.json
*.pem
*.p12
*.key
.secrets/

# Firebase
.firebase/
# Firebase Extensions — local secret references (point to Secret Manager; never commit)
extensions/*.local
extensions/*.secret.local
firebase-debug.log
firestore-debug.log
database-debug.log
ui-debug.log
*-debug.log
.runtimeconfig.json

# Test / coverage
coverage/
.vitest/

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Brainstorming visual companion (local only)
.superpowers/

# Agent worktrees nested in the checkout
.claude/worktrees/
